# ==============================================================================
# CrowdVision AI - Environment Configuration Example
# Copy this file to .env to override default parameters:
#   cp .env.example .env
# ==============================================================================

# Port Mappings on Docker Host
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Application Branding
PROJECT_NAME="CrowdVision AI"
PROJECT_TITLE="Real-Time Crowd Monitoring MVP"

# Default Baseline Crowd Capacity per zone
DEFAULT_CAPACITY=50

# Internal Container Paths (Defaults already set in docker-compose.yml)
YOLO_MODEL_PATH=/app/yolov8n.pt
DATABASE_PATH=/app/data/crowdvision.db

        "user_input": {
            "field": "Maximum Capacity",
            "type": "integer",
            "example": 50
        },
        "validation": [
            "Capacity must be greater than zero",
            "Capacity cannot be negative",
            "Capacity cannot be empty",
            "Prevent division by zero"
        ],
        "calculation": {
            "formula": "occupancy_percentage = (current_people / maximum_capacity) * 100"
        },
        "example": {
            "current_people": 35,
            "maximum_capacity": 50,
            "occupancy_percentage": 70
        }
    },
